# ---- Supabase (Project settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://supabase.com/dashboard/project/rofvunrbefufjmtumcqy
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Server only. Never expose to the browser. Used for account deletion and reminder emails.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://ami.ipthamani.top
NEXT_PUBLIC_EVENT_NAME=AMI Festival 2026
NEXT_PUBLIC_EVENT_VENUE=University of Venda
NEXT_PUBLIC_CONTACT_EMAIL=gateway@ami.ipthamani.top

# ---- Email (optional but recommended): summaries and reminders via Resend ----
RESEND_API_KEY=
EMAIL_FROM=AMI Gateway <gateway@ipthamani.top>

# ---- Cron (Vercel sends this as a Bearer token to /api/cron/*) ----
CRON_SECRET=generate-a-long-random-string
